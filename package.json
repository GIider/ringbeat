{
  "name": "ringbeat",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Browser rhythm game with charts generated from RTTTL ringtones, dressed as an old phone",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start":"node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs && node scripts/smoke.mjs",
    "dev": "node scripts/serve.mjs --dev",
    "coverage": "node --test --experimental-test-coverage tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build": "node scripts/build-dist.mjs",
    "bench": "node scripts/bench.mjs",
    "perf": "node --expose-gc scripts/perf-bench.mjs",
    "perf:play": "node scripts/perf-play.mjs",
    "perf:menus": "node scripts/perf-menus.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "font":"node scripts/build-font.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
